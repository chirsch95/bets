<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.bets.refresh-close</string>
    <!-- Closing-line capture runs: POST the local /refresh so
         the pipeline re-fetches odds and bets.main upserts the pre-game
         book_close_<date>.json board. Reduced from 4 runs to 1 on
         2026-06-25 after downgrading Odds API back to the 500/mo plan.
         Single 21:00 run captures west-coast closings; day/early-evening
         games close earlier but the model is in data-gathering mode so
         same-evening CLV is sufficient for analysis.
         /refresh holds the pipeline lock (no race with manual refreshes)
         and auto-pushes like every other Air refresh. -fsS + max-time so
         a hung Flask can't strand curl. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/curl</string>
        <string>-fsS</string>
        <string>-X</string>
        <string>POST</string>
        <string>--max-time</string>
        <string>300</string>
        <string>http://localhost:8000/refresh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key><string>/Users/chadhirsch/Library/Logs/bets-refresh-close.out</string>
    <key>StandardErrorPath</key><string>/Users/chadhirsch/Library/Logs/bets-refresh-close.err</string>
</dict>
</plist>
