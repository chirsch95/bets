<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.bets.refresh-close</string>
    <!-- Closing-line capture runs (2026-06-09): POST the local /refresh so
         the pipeline re-fetches odds and bets.main upserts the pre-game
         book_close_<date>.json board. Times (CT, Air-local) sit just ahead
         of the day's first-pitch waves so the LAST pre-game snapshot per
         game lands near its close:
           12:30 - early day games (~13:10 starts)
           17:45 - early evening games (~18:10-18:40)
           19:00 - prime-time games (~19:10-19:40)
           21:00 - west-coast games (~21:10-21:40)
         /refresh holds the pipeline lock (no race with manual refreshes)
         and auto-pushes like every other Air refresh. Odds credits are a
         non-issue on the 20K/mo plan with skip-started/skip-covered
         filtering. -fsS + max-time so a hung Flask can't strand curl. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/curl</string>
        <string>-fsS</string>
        <string>-X</string>
        <string>POST</string>
        <string>--max-time</string>
        <string>300</string>
        <string>http://localhost:8000/refresh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key><string>/Users/chadhirsch/Library/Logs/bets-refresh-close.out</string>
    <key>StandardErrorPath</key><string>/Users/chadhirsch/Library/Logs/bets-refresh-close.err</string>
</dict>
</plist>
